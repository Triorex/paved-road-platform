{
  "name": "paved-road-default-branch",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    },
    "repository_property": {
      "include": [
        {
          "name": "paved-road",
          "property_values": [
            "true"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": true,
        "required_status_checks": [
          {
            "context": "pr-security / gate"
          }
        ]
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "high_or_higher",
            "alerts_threshold": "errors"
          }
        ]
      }
    },
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "No AI co-author attribution",
        "negate": true,
        "operator": "regex",
        "pattern": "(?i)(co-authored-by:[^\\n]*(claude|anthropic)|generated with \\[?claude code)"
      }
    },
    {
      "type": "commit_author_email_pattern",
      "parameters": {
        "name": "No AI commit authors",
        "negate": true,
        "operator": "regex",
        "pattern": "(?i)@anthropic\\.com$"
      }
    }
  ]
}
